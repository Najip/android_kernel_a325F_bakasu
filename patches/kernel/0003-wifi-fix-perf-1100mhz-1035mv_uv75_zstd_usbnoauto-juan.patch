index e0909b050..6525620d0 100644
--- a/drivers/misc/mediatek/gpu/ged/src/ged_ski.c
+++ b/drivers/misc/mediatek/gpu/ged/src/ged_ski.c
@@ -11,6 +11,8 @@
  * See http://www.gnu.org/licenses/gpl-2.0.html for more details.
  */
 
+#include <linux/mutex.h>
+#include <linux/regulator/consumer.h>
 #include <mt-plat/mtk_gpu_utility.h>
 #include <mtk_gpufreq.h>
 #include "ged_ski.h"
@@ -225,6 +227,54 @@ ssize_t gpu_tmu_show(struct kobject *kobj,
 
 static KOBJ_ATTR_RO(gpu_tmu);
 
+/* Real clocks from the on-chip frequency meter (kHz) and CPU rail
+ * voltages read back from the PMIC (mV).  Field names kept as in the
+ * first build: "big" is ABIST 21 (ARMPLL_L, little cluster) and
+ * "little" is ABIST 22 (ARMPLL, big cluster).  vproc11 feeds the big
+ * cluster, vproc12 the little cluster and CCI.
+ */
+extern unsigned int mt_get_ckgen_freq(unsigned int ID);
+extern unsigned int mt_get_abist_freq(unsigned int ID);
+static DEFINE_MUTEX(gpu_fmeter_lock);
+static struct regulator *fm_vproc11, *fm_vproc12;
+
+static unsigned int fm_rail_mv(struct regulator **reg, const char *name)
+{
+	int uv;
+
+	if (IS_ERR_OR_NULL(*reg))
+		*reg = regulator_get_optional(NULL, name);
+	if (IS_ERR_OR_NULL(*reg))
+		return 0;
+	uv = regulator_get_voltage(*reg);
+	return uv > 0 ? uv / 1000 : 0;
+}
+
+ssize_t gpu_fmeter_show(struct kobject *kobj,
+		struct kobj_attribute *attr, char *buf)
+{
+	unsigned int gpu = 0, mfgpll = 0, big, little, cci, v11, v12;
+
+	mutex_lock(&gpu_fmeter_lock);
+	if (mt_gpufreq_get_cur_volt()) {
+		gpu = mt_get_ckgen_freq(5);
+		mfgpll = mt_get_abist_freq(25);
+	}
+	big = mt_get_abist_freq(21);
+	little = mt_get_abist_freq(22);
+	cci = mt_get_abist_freq(49);
+	v11 = fm_rail_mv(&fm_vproc11, "vproc11");
+	v12 = fm_rail_mv(&fm_vproc12, "vproc12");
+	mutex_unlock(&gpu_fmeter_lock);
+
+	return scnprintf(buf, PAGE_SIZE,
+		"gpu %u mfgpll %u big %u little %u cci %u vproc11 %u vproc12 %u\n",
+		gpu, mfgpll, big, little, cci, v11, v12);
+}
+
+static struct kobj_attribute kobj_attr_gpu_fmeter =
+	__ATTR(gpu_fmeter, 0444, gpu_fmeter_show, NULL);
+
 GED_ERROR ged_ski_init(void)
 {
 	int ret = GED_OK;
@@ -290,6 +340,12 @@ GED_ERROR ged_ski_init(void)
 		GED_LOGE("ged: failed to create gpu_tmu!\n");
 		goto EXIT;
 	}
+	ret = ged_sysfs_create_file(gpu_kobj, &kobj_attr_gpu_fmeter);
+	if (ret) {
+		ret = GED_ERROR_OOM;
+		GED_LOGE("ged: failed to create gpu_fmeter!\n");
+		goto EXIT;
+	}
 
 	return ret;
 
@@ -309,6 +365,7 @@ void ged_ski_exit(void)
 	ged_sysfs_remove_file(gpu_kobj, &kobj_attr_gpu_min_clock);
 	ged_sysfs_remove_file(gpu_kobj, &kobj_attr_gpu_model);
 	ged_sysfs_remove_file(gpu_kobj, &kobj_attr_gpu_tmu);
+	ged_sysfs_remove_file(gpu_kobj, &kobj_attr_gpu_fmeter);
 	kobject_put(gpu_kobj);
 	gpu_kobj = NULL;
 }
