+
+/*
+ * BakaSU sync-up calls this from its package observer and rename hook.
+ * Queue the parent kernel's existing delayed refresh; never resolve paths
+ * or override credentials directly from an fsnotify/rename callback.
+ */
+void susfs_parse_priority_app_strings(void)
+{
+	unsigned long delay;
+
+	delay = msecs_to_jiffies(250);
+	priority_queue_refresh(delay);
+}
+
+/*
+ * Compatibility shims for the BakaSU sync-up selinux integration.
+ * SUSFS v2.3.0 does not provide the newer per-type AVD / sus-type
+ * tracking API, so provide safe no-op implementations; BakaSU's
+ * selinux_hide still operates through its own non-susfs path.
+ */
+int susfs_add_sus_avd_allowed_by_type(u32 s_type, u32 t_type, u32 c_type, u32 orig_avd_allowed)
+{
+	return 0;
+}
+
+int susfs_add_sus_type(const char *secctx, u32 type_value)
+{
+	return 0;
+}
