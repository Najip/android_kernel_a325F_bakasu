mainmenu "Linux/$ARCH $KERNELVERSION Kernel Configuration"

config SRCARCH
	string
	option env="SRCARCH"

source "arch/$SRCARCH/Kconfig"

config XXKSU_MANUAL_HOOKS
	bool "xxKSU direct parent-kernel hooks"
	depends on KSU=y
	default y
