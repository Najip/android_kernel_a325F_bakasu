# Signing certificate of the KernelSU-Next manager APK this kernel should accept.
# Copy both values from the summary of the "KernelSU-Next manager APK" workflow run.
# Leave both empty to keep the official KernelSU-Next key.
# Values set in the environment of the build override this file.
KSU_NEXT_MANAGER_SIZE=
KSU_NEXT_MANAGER_HASH=
